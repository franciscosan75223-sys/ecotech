# Copia este archivo como .env y completa los datos de Connect > Session pooler.
# La contraseña es la de la BASE DE DATOS, no la de tu cuenta de Supabase.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
# Puedes dejarla vacía: Python la pedirá al iniciar sin mostrarla en pantalla.
SUPABASE_DB_PASSWORD=
# Incluye supabase-ca.crt y lo carga automaticamente. Deja esta variable vacia.
# Opcional: otro certificado CA; las rutas relativas parten de la carpeta de main.py.
# Se verifica siempre la identidad del servidor mediante SSL verify-full.
SUPABASE_SSLROOTCERT=
# Solo si necesitas usar una clave Fernet existente, indica su ruta aquí.
ECOTECH_FERNET_KEY_FILE=
